{
  "expo": {
    "name": "My Team Baseball",
    "slug": "my-team-baseball",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#1a472a",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myteambaseball.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a472a"
      },
      "package": "com.myteambaseball.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./src/assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "my-team-baseball"
  }
}