{
  "expo": {
    "name": "My Team Baseball",
    "slug": "my-team-baseball",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/app-icon/app-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash/splash-screen.png",
      "resizeMode": "cover",
      "backgroundColor": "#1A56DB"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.myteambaseball.app",
      "icon": "./assets/app-icon/app-icon.png"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon/app-icon.png",
        "backgroundColor": "#1A56DB"
      },
      "package": "com.myteambaseball.app"
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/app-icon/app-icon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "scheme": "my-team-baseball"
  }
}